JWT_SECRET_KEY=BhC4C9iCkHqAM72e4WVbiwBRGi0jgXCWs4CCPxG4pQQ
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration - Your production domain
CORS_ORIGINS=https://izishopin.com,https://www.izishopin.com,http://izishopin.com,http://www.izishopin.com

# Environment
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO

