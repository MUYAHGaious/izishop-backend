# ============================================================================
# IziShop Backend Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file to git (it's in .gitignore)

# ============================================================================
# MESOMB PAYMENT GATEWAY CONFIGURATION
# ============================================================================
# Get your credentials from: https://mesomb.hachther.com/
# Documentation: https://docs.mesomb.com/

# Required: Your MeSomb API Credentials
MESOMB_APPLICATION_KEY=your_application_key_here
MESOMB_ACCESS_KEY=your_access_key_here
MESOMB_SECRET_KEY=your_secret_key_here

# Optional: Operational Settings
MESOMB_ENABLED=true
MESOMB_TEST_MODE=true

# Notes:
# - MESOMB_TEST_MODE: Set to "true" for testing, "false" for production
# - In test mode, use MeSomb test phone numbers (see documentation)
# - Currency is automatically set to XAF (Central African Franc)
# - Country is automatically set to CM (Cameroon)
