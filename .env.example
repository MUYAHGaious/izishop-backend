# Izishop Backend Environment Variables
# Copy this file to .env and fill in the actual values

# Environment Configuration
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/izishop_prod
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Security Configuration (NEVER use default values in production)
SECRET_KEY=your-256-bit-secret-key-generated-with-secure-random
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ADMIN_ACCESS_CODE=secure-random-admin-code-minimum-32-characters

# JWT Configuration
JWT_ALGORITHM=HS256
JWT_AUDIENCE=izishop-api
JWT_ISSUER=izishop.com

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=your-redis-password

# API Configuration
TRANZAK_API_KEY=your-tranzak-api-key
TRANZAK_API_SECRET=your-tranzak-api-secret
TRANZAK_BASE_URL=https://api.tranzak.com

# Storage Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Email Configuration
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@izishop.com

# SMS Configuration
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=your-twilio-phone-number

# URL Configuration
FRONTEND_BASE_URL=https://izishop.com
BACKEND_BASE_URL=https://api.izishop.com

# Security Headers
ALLOWED_ORIGINS=https://izishop.com,https://www.izishop.com
TRUSTED_HOSTS=izishop.com,www.izishop.com,api.izishop.com

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=100
RATE_LIMIT_BURST=20

# Monitoring
SENTRY_DSN=your-sentry-dsn
ENABLE_METRICS=true